---
// Layout for the Weisiger Group homepage.
// All copy and links live in src/content/home.json. Content changes go there, not here.
import c from '../content/home.json';
import '../styles/global.css';

const buildSha = process.env.GITHUB_SHA || process.env.COMMIT_REF || 'local';
const newsGradients = [
  'radial-gradient(80% 120% at 80% 0%, #3675F0 0%, #0B3A78 50%, #022148 100%)',
  'radial-gradient(80% 120% at 20% 0%, #6EB9FF 0%, #2E6BD6 45%, #022148 100%)',
  'radial-gradient(80% 120% at 50% 100%, #3675F0 0%, #0B3A78 45%, #011836 100%)',
];
const chip = 'font-size: 12px; font-weight: 600; background: #EAF1FE; color: #1F4FB8; padding: 4px 9px; border-radius: 6px;';
const offer = 'font-size: 13px; font-weight: 600; color: #022148; background: #F3F7FF; border-radius: 8px; padding: 10px;';
const solution = 'display: flex; align-items: center; justify-content: space-between; background: rgba(255,255,255,0.06); border-radius: 10px; padding: 12px 14px; color: #ffffff; font-size: 14px;';
const eyebrow = 'font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: #4A5568;';
const companyName = 'margin: 0; font-size: 40px; font-weight: 500; color: #2D3748;';
const companyBody = 'margin: 0; font-size: 19px; line-height: 1.5; color: #2D3748; max-width: 480px;';
const companyLink = 'display: inline-flex; align-items: center; gap: 10px; font-size: 15px; font-weight: 500;';
const point = 'display: flex; align-items: center; gap: 12px; background: rgba(255,255,255,0.06); border: 1px solid rgba(110,185,255,0.2); border-radius: 12px; padding: 14px 16px; color: #ffffff; font-size: 15px;';
const footerHead = 'font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: #8FB0D8;';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<meta name="build-sha" content={buildSha}>
<title>{c.meta.title}</title>
<meta name="description" content={c.meta.description}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Golos+Text:wght@400;500;600;700&display=swap">
</head>
<body>
<div style="width: 100%; background: #ffffff; font-family: 'Golos Text', system-ui, sans-serif; color: #2D3748; overflow: hidden;">

<!-- HERO -->
<section style="background: radial-gradient(120% 90% at 75% 20%, #0B3A78 0%, #022148 55%, #011836 100%); border-radius: 0 0 50% 50% / 0 0 140px 140px; padding: 20px 24px 140px; position: relative;">
  <nav aria-label="Main" style="max-width: 1280px; margin: 0 auto; background: #ffffff; border-radius: 16px; padding: 10px 12px 10px 20px; display: flex; flex-wrap: wrap; align-items: center; gap: 16px; box-shadow: 0 8px 30px rgba(2,33,72,0.18);">
    <a href="/" style="display: flex; align-items: center;" aria-label={c.nav.homeLabel}>
      <img src="/weisiger_dark.svg" alt={c.nav.logoAlt} style="height: 40px; width: auto; display: block;">
    </a>
    <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 22px; margin-left: 20px; font-size: 14px; font-weight: 500; flex: 1 1 auto;">
      {c.nav.links.map((l) => {
        const hasMenu = /\s*\u2304$/.test(l.label);
        const label = l.label.replace(/\s*\u2304$/, '');
        return (
          <a href={l.href} style="color: #2D3748; display: inline-flex; align-items: center; gap: 6px; line-height: 1;">
            {label}
            {hasMenu && <svg aria-hidden="true" width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="display: block; flex: none;"><path d="M2 3.5l3 3 3-3"/></svg>}
          </a>
        );
      })}
    </div>
    <div style="display: flex; align-items: center; gap: 16px; font-size: 14px; font-weight: 500;">
      <a href={c.nav.vendor.href} style="color: #2D3748;">{c.nav.vendor.label}</a>
      <span aria-hidden="true" style="width: 1px; height: 18px; background: #E2EBF3;"></span>
      <a href={c.nav.cta.href} style="display: inline-flex; align-items: center; gap: 8px; background: #3675F0; color: #ffffff; padding: 11px 18px; border-radius: 10px; font-weight: 600;">{c.nav.cta.label} <svg aria-hidden="true" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 11L11 3M5 3h6v6"/></svg></a>
    </div>
  </nav>

  <div style="max-width: 1280px; margin: 0 auto; padding: 84px 8px 0; display: flex; flex-wrap: wrap; align-items: center; gap: 48px;">
    <div style="flex: 1 1 480px; min-width: 0; display: flex; flex-direction: column; gap: 22px;">
      <div style="font-size: 13px; font-weight: 600; letter-spacing: 0.08em; color: #C9DCF5; text-transform: uppercase;">{c.hero.eyebrow}</div>
      <h1 style="margin: 0; font-size: 54px; line-height: 1.08; font-weight: 500; color: #ffffff; letter-spacing: -0.01em; text-wrap: balance;">{c.hero.title} <span style="color: #6EB9FF;">{c.hero.titleHighlight}</span></h1>
      <p style="margin: 0; font-size: 19px; line-height: 1.55; color: #D6E2F2; max-width: 560px;">{c.hero.body}</p>
      <div style="display: flex; flex-wrap: wrap; gap: 12px; padding-top: 6px;">
        <a href={c.hero.primaryCta.href} style="display: inline-flex; align-items: center; gap: 10px; background: #ffffff; color: #022148; padding: 14px 22px; border-radius: 999px; font-size: 15px; font-weight: 600;">{c.hero.primaryCta.label} <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>
        <a href={c.hero.secondaryCta.href} style="display: inline-flex; align-items: center; gap: 10px; border: 1px solid rgba(255,255,255,0.35); color: #ffffff; padding: 14px 22px; border-radius: 999px; font-size: 15px; font-weight: 500;">{c.hero.secondaryCta.label}</a>
      </div>
    </div>

    <!-- territory visual -->
    <div style="flex: 1 1 460px; min-width: 0; position: relative; height: 470px;">
      <svg aria-hidden="true" viewBox="0 0 520 470" style="position: absolute; inset: 0; width: 100%; height: 100%;" fill="none">
        <g stroke="#6EB9FF" stroke-opacity="0.22" stroke-width="1.2">
          <ellipse cx="270" cy="235" rx="240" ry="200" transform="rotate(-18 270 235)"/>
          <ellipse cx="275" cy="232" rx="205" ry="168" transform="rotate(-14 275 232)"/>
          <ellipse cx="282" cy="228" rx="170" ry="138" transform="rotate(-10 282 228)"/>
          <ellipse cx="288" cy="224" rx="136" ry="108" transform="rotate(-6 288 224)"/>
          <ellipse cx="294" cy="220" rx="102" ry="80" transform="rotate(-2 294 220)"/>
          <ellipse cx="298" cy="216" rx="68" ry="52" transform="rotate(4 298 216)"/>
          <ellipse cx="300" cy="214" rx="34" ry="26" transform="rotate(10 300 214)"/>
        </g>
        <path d="M120 330 C180 300, 220 260, 300 214 S 420 150, 450 120" stroke="#6EB9FF" stroke-opacity="0.7" stroke-width="2" stroke-dasharray="4 6"/>
        <circle cx="300" cy="214" r="16" fill="#3675F0" fill-opacity="0.25"/>
        <circle cx="300" cy="214" r="6" fill="#6EB9FF"/>
        <circle cx="120" cy="330" r="5" fill="#6EB9FF"/>
        <circle cx="450" cy="120" r="5" fill="#6EB9FF"/>
        <circle cx="190" cy="150" r="4" fill="#ffffff" fill-opacity="0.7"/>
        <circle cx="400" cy="320" r="4" fill="#ffffff" fill-opacity="0.7"/>
      </svg>
      <div style="position: absolute; left: 6%; top: 20px; background: #ffffff; border-radius: 14px; padding: 14px 16px; box-shadow: 0 16px 40px rgba(1,24,54,0.35); width: 230px; display: flex; flex-direction: column; gap: 6px;">
        <div style="font-size: 12px; color: #4A5568;">{c.hero.headquarters.label}</div>
        <div style="font-size: 16px; font-weight: 600; color: #022148;">{c.hero.headquarters.value}</div>
        <div style="display: flex; align-items: center; gap: 6px; font-size: 12px; color: #2D3748;"><span style="width: 8px; height: 8px; border-radius: 50%; background: #66CC72;"></span>{c.hero.headquarters.note}</div>
      </div>
      <div style="position: absolute; right: 2%; top: 170px; background: #ffffff; border-radius: 14px; padding: 14px 16px; box-shadow: 0 16px 40px rgba(1,24,54,0.35); width: 250px; display: flex; flex-direction: column; gap: 10px;">
        <div style="font-size: 12px; color: #4A5568;">{c.hero.region.label}</div>
        <div style="display: flex; flex-wrap: wrap; gap: 6px;">
          {c.hero.region.states.map((s) => <span style={chip}>{s}</span>)}
        </div>
        <div style="font-size: 13px; color: #2D3748;">{c.hero.region.note}</div>
      </div>
      <div style="position: absolute; left: 18%; bottom: 24px; background: rgba(255,255,255,0.08); border: 1px solid rgba(110,185,255,0.35); border-radius: 14px; padding: 12px 16px; color: #ffffff; display: flex; align-items: center; gap: 12px;">
        <span style="font-size: 30px; font-weight: 600; color: #6EB9FF;">{c.hero.years.value}</span>
        <span style="font-size: 13px; line-height: 1.35; color: #D6E2F2;">{c.hero.years.line1}<br>{c.hero.years.line2}</span>
      </div>
    </div>
  </div>
</section>

<!-- COMPANIES -->
<section id="companies" style="padding: 90px 24px 40px;">
  <div style="max-width: 1180px; margin: 0 auto; display: flex; flex-direction: column; gap: 110px;">
    <h2 style="margin: 0; text-align: center; font-size: 44px; font-weight: 500; color: #2D3748;">{c.companies.title} <span style="color: #3675F0;">{c.companies.titleHighlight}</span></h2>

    <!-- row 1: Carolina Cat -->
    <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 64px;">
      <div style="flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 18px;">
        <div style={eyebrow}>{c.companies.carolinaCat.eyebrow}</div>
        <h3 style={companyName}>{c.companies.carolinaCat.name}</h3>
        <p style={companyBody}>{c.companies.carolinaCat.body}</p>
        <a href={c.companies.carolinaCat.link.href} style={companyLink}>{c.companies.carolinaCat.link.label} <svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 9h12M10 4l5 5-5 5"/></svg></a>
      </div>
      <div style="flex: 1 1 440px; min-width: 0; position: relative; height: 360px;">
        <div style="position: absolute; left: 10%; right: 4%; top: 40px; bottom: 30px; background: #F3F7FF; border: 1px solid #E2EBF3; border-radius: 18px;"></div>
        <div style="position: absolute; left: 4%; top: 0; width: 290px; background: #ffffff; border: 1px solid #E2EBF3; border-radius: 14px; padding: 16px; box-shadow: 0 12px 30px rgba(2,33,72,0.10); display: flex; flex-direction: column; gap: 12px;">
          <div style="font-size: 13px; color: #4A5568;">{c.companies.carolinaCat.offerLabel}</div>
          <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px;">
            {c.companies.carolinaCat.offers.map((o) => <span style={offer}>{o}</span>)}
          </div>
        </div>
        <div style="position: absolute; right: 0; bottom: 0; width: 280px; background: #022148; color: #ffffff; border-radius: 14px; padding: 16px; box-shadow: 0 16px 36px rgba(2,33,72,0.25); display: flex; flex-direction: column; gap: 10px;">
          <div style="display: flex; justify-content: space-between; align-items: center;"><span style="font-size: 13px; color: #C9DCF5;">{c.companies.carolinaCat.rentals.name}</span><span style="font-size: 11px; font-weight: 600; background: #3675F0; padding: 3px 8px; border-radius: 6px;">{c.companies.carolinaCat.rentals.badge}</span></div>
          <div style="font-size: 15px; font-weight: 600;">{c.companies.carolinaCat.rentals.title}</div>
          <div style="font-size: 12px; color: #C9DCF5;">{c.companies.carolinaCat.rentals.area}</div>
        </div>
      </div>
    </div>

    <!-- row 2: Power Systems -->
    <div style="display: flex; flex-wrap: wrap-reverse; align-items: center; gap: 64px;">
      <div style="flex: 1 1 440px; min-width: 0; position: relative; height: 360px;">
        <div style="position: absolute; left: 0; top: 30px; width: 76%; bottom: 20px; background: #0A2D5C; border-radius: 18px; padding: 22px; display: flex; flex-direction: column; gap: 12px;">
          <div style="font-size: 13px; color: #C9DCF5;">{c.companies.powerSystems.panelLabel}</div>
          {c.companies.powerSystems.solutions.map((s) => <div style={solution}><span>{s.name}</span><span style="color: #66CC72; font-size: 12px;">● {s.services}</span></div>)}
        </div>
        <div style="position: absolute; right: 0; top: 0; width: 230px; background: #ffffff; border: 1px solid #E2EBF3; border-radius: 14px; padding: 14px 16px; box-shadow: 0 12px 30px rgba(2,33,72,0.12); display: flex; flex-direction: column; gap: 6px;">
          <div style="font-size: 12px; color: #4A5568;">{c.companies.powerSystems.expanding.label}</div>
          <div style="font-size: 16px; font-weight: 600; color: #022148;">{c.companies.powerSystems.expanding.title}</div>
          <div style="font-size: 12px; color: #2D3748;">{c.companies.powerSystems.expanding.body}</div>
        </div>
        <div style="position: absolute; right: 6%; bottom: 0; background: #ffffff; border: 1px solid #E2EBF3; border-radius: 12px; padding: 10px 14px; box-shadow: 0 10px 24px rgba(2,33,72,0.10); font-size: 13px; color: #2D3748;">{c.companies.powerSystems.rental.text} <strong style="color: #022148;">{c.companies.powerSystems.rental.emphasis}</strong></div>
      </div>
      <div style="flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 18px;">
        <div style={eyebrow}>{c.companies.powerSystems.eyebrow}</div>
        <h3 style={companyName}>{c.companies.powerSystems.name}</h3>
        <p style={companyBody}>{c.companies.powerSystems.body}</p>
        <a href={c.companies.powerSystems.link.href} style={companyLink}>{c.companies.powerSystems.link.label} <svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 9h12M10 4l5 5-5 5"/></svg></a>
      </div>
    </div>

    <!-- row 3: LiftOne -->
    <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 64px;">
      <div style="flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 18px;">
        <div style={eyebrow}>{c.companies.liftOne.eyebrow}</div>
        <h3 style={companyName}>{c.companies.liftOne.name}</h3>
        <p style={companyBody}>{c.companies.liftOne.body}</p>
        <a href={c.companies.liftOne.link.href} style={companyLink}>{c.companies.liftOne.link.label} <svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 9h12M10 4l5 5-5 5"/></svg></a>
      </div>
      <div style="flex: 1 1 440px; min-width: 0; position: relative; height: 360px;">
        <div style="position: absolute; inset: 20px 0 20px 8%; background: #F3F7FF; border: 1px solid #E2EBF3; border-radius: 18px; padding: 22px; display: flex; flex-direction: column; gap: 14px;">
          <div style="display: flex; justify-content: space-between; align-items: baseline;"><span style="font-size: 13px; color: #4A5568;">{c.companies.liftOne.locationsLabel}</span><span style="font-size: 28px; font-weight: 600; color: #022148;">{c.companies.liftOne.locationsTotal}</span></div>
          <div style="display: flex; flex-direction: column; gap: 10px;">
            {c.companies.liftOne.states.map((s, i) => (
              <div style="display: grid; grid-template-columns: 40px minmax(0, 1fr); align-items: center; gap: 10px; font-size: 13px; color: #2D3748;"><span>{s.state}</span><span style={`height: 10px; border-radius: 5px; background: ${i === 0 ? '#3675F0' : '#6EB9FF'}; width: ${s.barPercent}%;`}></span></div>
            ))}
          </div>
          <div style="font-size: 11px; color: #4A5568;">{c.companies.liftOne.barsNote}</div>
        </div>
        <div style="position: absolute; left: 0; bottom: 0; background: #ffffff; border: 1px solid #E2EBF3; border-radius: 12px; padding: 12px 16px; box-shadow: 0 12px 30px rgba(2,33,72,0.12); display: flex; align-items: center; gap: 10px;"><span style="font-size: 22px; font-weight: 600; color: #3675F0;">{c.companies.liftOne.technicians.value}</span><span style="font-size: 13px; color: #2D3748;">{c.companies.liftOne.technicians.label}</span></div>
      </div>
    </div>

    <!-- more companies -->
    <div style="display: flex; flex-direction: column; gap: 24px;">
      <h3 style="margin: 0; font-size: 26px; font-weight: 500; color: #2D3748; text-align: center;">{c.companies.more.title}</h3>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px;">
        {c.companies.more.items.map((m) => (
          <a href={m.href} style="background: #ffffff; border: 1px solid #E2EBF3; border-radius: 16px; padding: 20px; display: flex; flex-direction: column; gap: 10px; color: #2D3748; box-shadow: 0 6px 18px rgba(2,33,72,0.05);"><span style="font-size: 17px; font-weight: 600; color: #022148;">{m.name}</span><span style="font-size: 14px; line-height: 1.45;">{m.description}</span><span style="margin-top: auto; font-size: 13px; color: #2F68DB;">{c.companies.more.linkLabel}</span></a>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- WHY WEISIGER -->
<section style="padding: 100px 24px 40px;">
  <div style="max-width: 1280px; margin: 0 auto; display: flex; flex-direction: column; gap: 40px;">
    <h2 style="margin: 0; text-align: center; font-size: 44px; font-weight: 500; color: #2D3748;">{c.why.title} <span style="color: #3675F0;">{c.why.titleHighlight}</span></h2>

    <div style="background: radial-gradient(90% 120% at 85% 50%, #0B3A78 0%, #022148 60%); border-radius: 32px; padding: 64px 56px; display: flex; flex-wrap: wrap; align-items: center; gap: 48px; position: relative; overflow: hidden;">
      <svg aria-hidden="true" viewBox="0 0 600 400" style="position: absolute; right: -60px; top: -40px; width: 640px; height: 480px;" fill="none"><g stroke="#6EB9FF" stroke-opacity="0.16" stroke-width="1.2"><circle cx="360" cy="220" r="60"/><circle cx="360" cy="220" r="100"/><circle cx="360" cy="220" r="140"/><circle cx="360" cy="220" r="180"/><circle cx="360" cy="220" r="220"/><circle cx="360" cy="220" r="260"/></g></svg>
      <div style="flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 16px; position: relative;">
        <h3 style="margin: 0; font-size: 34px; line-height: 1.2; font-weight: 500; color: #ffffff;">{c.why.story.title}</h3>
        <p style="margin: 0; font-size: 17px; line-height: 1.55; color: #D6E2F2; max-width: 520px;">{c.why.story.body}</p>
        <a href={c.why.story.link.href} style="align-self: flex-start; display: inline-flex; align-items: center; gap: 10px; color: #6EB9FF; font-size: 15px; font-weight: 500;">{c.why.story.link.label} <svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 9h12M10 4l5 5-5 5"/></svg></a>
      </div>
      <div style="flex: 0 1 300px; min-width: 0; position: relative; display: flex; justify-content: center;">
        <div style="width: 260px; height: 260px; border-radius: 50%; border: 2px solid rgba(110,185,255,0.25); border-top-color: #6EB9FF; border-right-color: #6EB9FF; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px;">
          <span style="font-size: 60px; font-weight: 500; color: #ffffff; letter-spacing: -0.02em;">{c.why.story.year}</span>
          <span style="font-size: 14px; color: #C9DCF5; text-align: center; max-width: 160px;">{c.why.story.yearCaption}</span>
        </div>
      </div>
    </div>

    <div style="display: flex; flex-wrap: wrap; gap: 24px;">
      <div style="flex: 1 1 520px; min-width: 0; background: #0A2D5C; border-radius: 32px; padding: 48px; display: flex; flex-direction: column; gap: 22px;">
        <h3 style="margin: 0; font-size: 30px; font-weight: 500; color: #ffffff;">{c.why.community.title}</h3>
        <p style="margin: 0; font-size: 16px; line-height: 1.55; color: #D6E2F2; max-width: 520px;">{c.why.community.body}</p>
        <div style="display: flex; flex-direction: column; gap: 10px;">
          {c.why.community.points.map((p) => <div style={point}><svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="#6EB9FF" stroke-width="1.8"><path d="M4 9l3.5 3.5L14 6"/></svg>{p}</div>)}
        </div>
        <a href={c.why.community.cta.href} style="align-self: flex-start; display: inline-flex; align-items: center; gap: 10px; background: #ffffff; color: #022148; padding: 13px 20px; border-radius: 999px; font-size: 15px; font-weight: 600;">{c.why.community.cta.label}</a>
      </div>
      <div style="flex: 1 1 360px; min-width: 0; background: #F3F7FF; border: 1px solid #E2EBF3; border-radius: 32px; padding: 48px; display: flex; flex-direction: column; gap: 18px;">
        <span style="align-self: flex-start; font-size: 12px; font-weight: 600; background: #EAF1FE; color: #1F4FB8; padding: 5px 10px; border-radius: 6px;">{c.why.cares.badge}</span>
        <h3 style="margin: 0; font-size: 28px; line-height: 1.25; font-weight: 500; color: #022148;">{c.why.cares.title}</h3>
        <p style="margin: 0; font-size: 16px; line-height: 1.55; color: #2D3748;">{c.why.cares.body}</p>
        <a href={c.why.cares.cta.href} style="margin-top: auto; align-self: flex-start; display: inline-flex; align-items: center; gap: 10px; background: #3675F0; color: #ffffff; padding: 13px 20px; border-radius: 999px; font-size: 15px; font-weight: 600;">{c.why.cares.cta.label}</a>
      </div>
    </div>
  </div>
</section>

<!-- CAREERS CTA -->
<section style="padding: 60px 24px 40px;">
  <div style="max-width: 1280px; margin: 0 auto; background: radial-gradient(70% 90% at 50% 120%, #2E6BD6 0%, #0B3A78 35%, #011836 75%); border-radius: 32px; padding: 110px 32px 120px; display: flex; flex-direction: column; align-items: center; gap: 20px; text-align: center; position: relative; overflow: hidden;">
    <div aria-hidden="true" style="position: absolute; left: -10%; right: -10%; bottom: -560px; height: 700px; border-radius: 50%; border-top: 2px solid rgba(110,185,255,0.7); box-shadow: 0 -20px 80px rgba(54,117,240,0.45);"></div>
    <h2 style="margin: 0; font-size: 48px; line-height: 1.15; font-weight: 500; color: #ffffff; max-width: 760px; text-wrap: balance; position: relative;">{c.careers.title}</h2>
    <p style="margin: 0; font-size: 18px; line-height: 1.55; color: #D6E2F2; max-width: 620px; position: relative;">{c.careers.body}</p>
    <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; position: relative; padding-top: 8px;">
      <a href={c.careers.primaryCta.href} style="display: inline-flex; align-items: center; gap: 10px; background: #3675F0; color: #ffffff; padding: 14px 24px; border-radius: 10px; font-size: 15px; font-weight: 600;">{c.careers.primaryCta.label} <svg aria-hidden="true" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 11L11 3M5 3h6v6"/></svg></a>
      <a href={c.careers.secondaryCta.href} style="display: inline-flex; align-items: center; gap: 10px; border: 1px solid rgba(255,255,255,0.4); color: #ffffff; padding: 14px 24px; border-radius: 10px; font-size: 15px; font-weight: 500;">{c.careers.secondaryCta.label}</a>
    </div>
  </div>
</section>

<!-- NEWS -->
<section style="padding: 80px 24px 100px;">
  <div style="max-width: 1280px; margin: 0 auto; display: flex; flex-direction: column; gap: 36px;">
    <div style="display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 20px;">
      <h2 style="margin: 0; font-size: 32px; font-weight: 500; color: #2D3748;">{c.news.title}</h2>
      <a href={c.news.cta.href} style="display: inline-flex; align-items: center; gap: 8px; background: #3675F0; color: #ffffff; padding: 10px 18px; border-radius: 999px; font-size: 14px; font-weight: 600;">{c.news.cta.label} <svg aria-hidden="true" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 11L11 3M5 3h6v6"/></svg></a>
    </div>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px;">
      {c.news.items.map((n, i) => (
        <a href={n.href} style="background: #ffffff; border: 1px solid #E2EBF3; border-radius: 20px; padding: 10px 10px 22px; display: flex; flex-direction: column; gap: 14px; color: #2D3748; box-shadow: 0 8px 24px rgba(2,33,72,0.06);">
          <div style={`height: 180px; border-radius: 14px; background: ${newsGradients[i % newsGradients.length]}; display: flex; align-items: flex-end; padding: 16px; color: #ffffff; font-size: 15px; font-weight: 600;`}>{c.news.imageLabel}</div>
          <div style="display: flex; gap: 6px; padding: 0 8px;"><span style="font-size: 12px; background: #EEF2F7; padding: 4px 9px; border-radius: 6px;">{n.tag}</span></div>
          <span style="padding: 0 8px; font-size: 20px; line-height: 1.3; font-weight: 600; color: #022148;">{n.title}</span>
          <span style="padding: 0 8px; font-size: 14px; color: #2F68DB;">{c.news.readMore}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- FOOTER -->
<footer style="background: #022148; color: #D6E2F2; padding: 64px 24px 40px;">
  <div style="max-width: 1280px; margin: 0 auto; display: flex; flex-direction: column; gap: 40px;">
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; gap: 40px;">
      <div style="flex: 1 1 280px; min-width: 0; display: flex; flex-direction: column; gap: 14px;">
        <img src="/weisiger_white.svg" alt={c.footer.logoAlt} style="height: 64px; width: auto; align-self: flex-start;">
        <p style="margin: 0; font-size: 22px; font-weight: 500; color: #ffffff; max-width: 320px;">{c.footer.tagline}</p>
      </div>
      <div style="display: flex; flex-wrap: wrap; gap: 56px; font-size: 14px;">
        {c.footer.columns.map((col) => (
          <div style="display: flex; flex-direction: column; gap: 10px;"><span style={footerHead}>{col.title}</span>{col.links.map((l) => <a href={l.href} style="color: #ffffff;">{l.label}</a>)}</div>
        ))}
      </div>
    </div>
    <div style="border-top: 1px solid rgba(201,220,245,0.18); padding-top: 22px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; font-size: 13px; color: #8FB0D8;">
      <span>{c.footer.copyright}</span>
      <div style="display: flex; flex-wrap: wrap; gap: 20px;">{c.footer.legal.map((l) => <a href={l.href} style="color: #C9DCF5;">{l.label}</a>)}</div>
    </div>
  </div>
</footer>

</div>
</body>
</html>
